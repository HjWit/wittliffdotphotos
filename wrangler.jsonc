{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "wittliffdotphotos",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "wittliff-dot-photos","database_id": "856a4a7b-1ad0-426b-b969-0f1f54a644ba",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "wittliff-dot-photos","preview_bucket_name": "wittliff-dot-photos",
		},
	],
	// Sandboxed plugins require Worker Loader, available on Workers paid plans. Uncomment to enable:
	// "worker_loaders": [{ "binding": "LOADER" }],
	// General maintenance cron trigger
	"triggers": {
		"crons": ["* * * * *"],
	},
}
